{
  "name": "emberterm",
  "private": true,
  "version": "1.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "cd packages/desktop && cargo tauri dev",
    "dev:ui": "pnpm --filter @emberterm/app dev",
    "build": "turbo build",
    "check": "turbo check",
    "test": "turbo test",
    "lint": "turbo lint",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set"
  },
  "devDependencies": {
    "turbo": "^2"
  }
}
